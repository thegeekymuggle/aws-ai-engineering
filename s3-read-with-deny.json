{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::shashank-week1-data-<ACCOUNT_ID>" },
    { "Effect": "Allow", "Action": "s3:*",          "Resource": "arn:aws:s3:::shashank-week1-data-<ACCOUNT_ID>/*" },
    { "Effect": "Deny",  "Action": "s3:GetObject",  "Resource": "arn:aws:s3:::shashank-week1-data-<ACCOUNT_ID>/hello.txt" }
  ]
}
